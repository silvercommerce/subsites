{
    "name": "silvercommerce/subsites",
    "description": "Module adding extra extensions to allow automatic integration of silverstripe/subsites with SilverCommerce Modules",
    "type": "silverstripe-vendormodule",
    "homepage": "https://github.com/silvercommerce/catalogue-admin",
    "keywords": [
        "silverstripe",
        "commerce",
        "ecommerce",
        "subsites"
    ],
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Dean Forest Tech",
            "homepage": "https://dean-forest-tech.uk"
        }
    ],
    "support": {
        "issues": "https://github.com/silvercommerce/subsites/issues"
    },
    "require": {
        "silverstripe/framework": "~5",
        "silverstripe/subsites": "~3"
    },
    "autoload": {
        "psr-4": {
            "SilverCommerce\\Subsites\\": "src/"
        }
    }
}
